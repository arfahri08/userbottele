# Telegram API
API_ID=your_api_id_here
API_HASH=your_api_hash_here
PHONE_NUMBER=+62xxxxxxxxxxxx

# Features
AUTOREPLY_ENABLED=False
ANTI_VIEWONCE_ENABLED=True
ANTI_DELETE_ENABLED=True
RESTRICTED_CHANNEL_ENABLED=True
LOGGER_ENABLED=True
TELEGRAM_MEDIA_LINK_ENABLED=True

# Anti-viewonce settings
SAVE_TO_SAVED_MESSAGES=True
FORWARD_CHAT_ID=0

# Autoreply messages are in data/autoreplies.json.
# Add/list/delete from Telegram: .addrep pesan, .replies, .delrep nomor

# Username tracker: simpan User ID + riwayat username akun yang pernah chat
USERNAME_TRACKER_ENABLED=True
USERNAME_TRACKER_SCAN_MINUTES=60

# Paid media guard: deteksi Stars media, native-forward tanpa membuka paywall
PAID_MEDIA_GUARD_ENABLED=True
PAID_MEDIA_FORWARD_TO_SAVED=True

# Downloader (opsional)
DOWNLOADER_API_TIMEOUT=30
TIKTOK_CDN_RETRIES=3
# Isi path cookies Netscape hanya jika fallback yt-dlp membutuhkannya.
YTDLP_COOKIES=

# Hot reload fallback untuk shared storage Android/Termux
INTERNAL_SOURCE_WATCH_ENABLED=True
INTERNAL_SOURCE_WATCH_INTERVAL=3
INTERNAL_SOURCE_WATCH_DEBOUNCE=2
